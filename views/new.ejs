<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>new Chats</title>
    <link href="/style.css" rel="stylesheet">
</head>
<body>
    <h2><b>New Chat</b></h2>
    <form method="post" action="/chats" class="new form">
        <input placeholder="who are you" name="from"/>
        <br><br>
        <textarea name="msg" placeholder="Write a message here.." class="text"></textarea>
        <br><br>
        <input placeholder="add receiver" name="to"/>
        <br>
        <button>create chat</button>
    </form>
</body>
</html>